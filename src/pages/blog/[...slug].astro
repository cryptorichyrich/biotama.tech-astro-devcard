---
import Layout from "@/web/components/layout.astro";
import ThemeToggle from "@/web/components/theme-toggle.astro";
import cv from "@/data";
import { getCollection } from "astro:content";

const { config, sections } = cv();

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Post-specific SEO overrides
const postTitle = `${post.data.title} — Bio Lumbantoruan`;
const postDescription = post.data.description;
const postImage = post.data.image
  ? new URL(post.data.image, Astro.site).href
  : new URL('/images/og-default.svg', Astro.site).href;
const canonicalURL = new URL(`/blog/${post.slug}`, Astro.site).href;
const publishedTime = post.data.pubDate.toISOString();
const author = post.data.author || 'Bio Lumbantoruan';
const tags = post.data.tags || [];

// Override meta for this specific post
const postMeta = {
  ...config.meta,
  title: postTitle,
  description: postDescription,
  ogTitle: post.data.title,
  ogDescription: postDescription,
  ogImage: postImage,
};

// BlogPosting JSON-LD
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: postDescription,
  image: postImage,
  datePublished: publishedTime,
  author: {
    '@type': 'Person',
    name: author,
    url: 'https://biotama.cv',
  },
  publisher: {
    '@type': 'Person',
    name: 'Bio Lumbantoruan',
    url: 'https://biotama.cv',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://biotama.cv',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://biotama.cv/#blog',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonicalURL,
    },
  ],
};

const jsonLd = [blogPostingSchema, breadcrumbSchema];

const article = {
  publishedTime,
  author,
  tags,
  section: 'Technology',
};
---

<Layout {...config} meta={postMeta} sections={sections} ogType="article" canonicalURL={canonicalURL} article={article} jsonLd={jsonLd}>
  <ThemeToggle />
  <main class="w-full max-w-3xl mx-auto space-y-4 px-2 py-3 sm:space-y-6 sm:px-8 sm:py-12 lg:space-y-8 lg:py-20">
    <a href="/#blog" class="text-sm text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
      &larr; Back to Blog
    </a>
    <article>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100">{post.data.title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={post.data.pubDate.toISOString().split('T')[0]}>
          {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <span>&middot;</span>
        <span>{post.data.author}</span>
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
              {tag}
            </span>
          ))}
        </div>
      )}
      {post.data.image && (
        <img
          src={post.data.image}
          alt={post.data.title}
          width="1200"
          height="630"
          loading="lazy"
          class="mt-6 w-full rounded-xl"
        />
      )}
      <div class="prose prose-gray mt-8 max-w-none dark:prose-invert">
        <Content />
      </div>
    </article>
  </main>
</Layout>
