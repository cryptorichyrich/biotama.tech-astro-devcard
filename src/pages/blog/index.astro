---
import Layout from "@/web/components/layout.astro";
import Sidebar from "@/web/components/sidebar.astro";
import cv from "@/data";
import { getCollection } from "astro:content";

const { config, sections } = cv();

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
---

<Layout {...config} sections={sections}>
  <main class="w-full max-w-5xl space-y-4 px-2 py-3 sm:space-y-6 sm:px-8 sm:py-12 lg:space-y-8 lg:py-20">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Blog</h1>
    <div class="space-y-6">
      {posts.map((post) => (
        <article class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-[#0f0f0f]">
          <a href={`/blog/${post.slug}`} class="text-xl font-semibold text-gray-900 hover:text-blue-600 dark:text-gray-100 dark:hover:text-blue-400">
            {post.data.title}
          </a>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </p>
          <p class="mt-2 text-gray-700 dark:text-gray-300">{post.data.description}</p>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </main>
  <Sidebar sections={sections} className="sticky top-8 mt-20" />
</Layout>