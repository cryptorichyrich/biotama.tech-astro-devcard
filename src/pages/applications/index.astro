---
import Fonts from '@/components/fonts.astro';
import cv from '@/data';
import { getAllApplications } from '@/data/applications';
import type { Application } from '@/data/applications/schema';

const { config, sections } = cv();
const { main } = sections;
const apps = await getAllApplications();

const statusBadge = (status: string) => {
  const colors: Record<string, { bg: string; text: string; label: string }> = {
    draft: { bg: '#f1f5f9', text: '#475569', label: 'Draft' },
    applied: { bg: '#dbeafe', text: '#1d4ed8', label: 'Applied' },
    interview: { bg: '#fef3c7', text: '#92400e', label: 'Interview' },
    offer: { bg: '#d1fae5', text: '#065f46', label: 'Offer' },
    rejected: { bg: '#fee2e2', text: '#991b1b', label: 'Rejected' },
  };
  return colors[status] || colors.draft;
};

const typeLabel = (type: string) => {
  const labels: Record<string, string> = {
    'full-time': 'Full-time',
    'part-time': 'Part-time',
    'contract': 'Contract',
    'freelance': 'Freelance',
  };
  return labels[type] || type;
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Job Applications — {main.fullName}</title>
    <Fonts />
  </head>
  <body style="background-color: #f8fafc; margin: 0; padding: 0; font-family: 'Inter var', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">

    <div style="max-width: 900px; margin: 0 auto; padding: 40px 24px;">

      <!-- HEADER -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div>
          <h1 style="font-size: 28px; font-weight: 800; color: #0f172a; margin: 0;">
            Job Applications
          </h1>
          <p style="font-size: 14px; color: #64748b; margin: 6px 0 0 0;">
            {main.fullName} — Application Tracker
          </p>
        </div>
        <a href="/"
          style="background-color: #1e293b; color: #ffffff; padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none;"
        >
          ← Portfolio
        </a>
      </div>

      <!-- STATS -->
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 40px;">
        <div style="background: white; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0;">
          <p style="font-size: 32px; font-weight: 800; color: #0f172a; margin: 0;">{apps.length}</p>
          <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0; text-transform: uppercase; letter-spacing: 1px;">Total</p>
        </div>
        <div style="background: white; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0;">
          <p style="font-size: 32px; font-weight: 800; color: #1d4ed8; margin: 0;">{apps.filter(a => a.application.status === 'applied').length}</p>
          <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0; text-transform: uppercase; letter-spacing: 1px;">Applied</p>
        </div>
        <div style="background: white; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0;">
          <p style="font-size: 32px; font-weight: 800; color: #92400e; margin: 0;">{apps.filter(a => a.application.status === 'interview').length}</p>
          <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0; text-transform: uppercase; letter-spacing: 1px;">Interview</p>
        </div>
        <div style="background: white; border-radius: 12px; padding: 20px; border: 1px solid #e2e8f0;">
          <p style="font-size: 32px; font-weight: 800; color: #059669; margin: 0;">{apps.filter(a => a.application.status === 'offer').length}</p>
          <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0; text-transform: uppercase; letter-spacing: 1px;">Offers</p>
        </div>
      </div>

      <!-- EMPTY STATE -->
      {apps.length === 0 && (
        <div style="text-align: center; padding: 60px 20px; background: white; border-radius: 12px; border: 1px solid #e2e8f0;">
          <p style="font-size: 18px; font-weight: 600; color: #0f172a; margin: 0;">No applications yet</p>
          <p style="font-size: 14px; color: #64748b; margin: 8px 0 0 0;">
            Share a job posting with Hermes to create your first tailored application.
          </p>
        </div>
      )}

      <!-- APPLICATION CARDS -->
      <div style="display: flex; flex-direction: column; gap: 16px;">
        {apps.map((app: Application) => {
          const badge = statusBadge(app.application.status);
          return (
            <div style="background: white; border-radius: 12px; padding: 24px; border: 1px solid #e2e8f0; transition: box-shadow 0.2s;">
              <!-- Card Header -->
              <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <h2 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0;">
                      {app.position.title}
                    </h2>
                    <span style={`background-color: ${badge.bg}; color: ${badge.text}; padding: 3px 10px; border-radius: 20px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;`}>
                      {badge.label}
                    </span>
                  </div>
                  <p style="font-size: 14px; color: #475569; margin: 4px 0 0 0;">
                    {app.company.name}
                    <span style="color: #94a3b8; margin: 0 6px;">•</span>
                    {app.company.location}
                    <span style="color: #94a3b8; margin: 0 6px;">•</span>
                    {typeLabel(app.position.type)}
                    {app.position.remote && <span style="color: #059669; margin-left: 4px;">Remote</span>}
                  </p>
                  {app.position.salaryRange && (
                    <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">
                      💰 {app.position.salaryRange}
                    </p>
                  )}
                </div>
                <span style="font-size: 11px; color: #94a3b8;">
                  {new Date(app.source.dateFound).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
              </div>

              <!-- Requirements Match -->
              <div style="margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px;">
                {app.jobDescription.requirements.slice(0, 6).map((req) => (
                  <span style={`padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 500; ${
                    req.importance === 'required'
                      ? 'background-color: #fef2f2; color: #991b1b;'
                      : req.importance === 'preferred'
                      ? 'background-color: #fffbeb; color: #92400e;'
                      : 'background-color: #f0fdf4; color: #166534;'
                  }`}>
                    {req.importance === 'required' ? '● ' : req.importance === 'preferred' ? '◐ ' : '○ '}
                    {req.skill}
                  </span>
                ))}
              </div>

              <!-- Actions -->
              <div style="margin-top: 16px; display: flex; gap: 10px;">
                <a href={`/resume/${app.slug}`}
                  style="background-color: #0f172a; color: #ffffff; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none;"
                >
                  📄 Tailored Resume
                </a>
                <a href={`/cover-letter/${app.slug}`}
                  style="background-color: #ffffff; color: #0f172a; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none; border: 1px solid #cbd5e1;"
                >
                  ✉️ Cover Letter
                </a>
                {app.source.url && (
                  <a href={app.source.url} target="_blank" rel="noopener noreferrer"
                    style="background-color: #ffffff; color: #475569; padding: 8px 16px; border-radius: 8px; font-size: 12px; font-weight: 500; text-decoration: none; border: 1px solid #e2e8f0;"
                  >
                    🔗 Job Posting
                  </a>
                )}
              </div>

              {app.application.notes && (
                <p style="margin-top: 12px; font-size: 11px; color: #94a3b8; padding-top: 12px; border-top: 1px solid #f1f5f9;">
                  📝 {app.application.notes}
                </p>
              )}
            </div>
          );
        })}
      </div>

      <!-- FOOTER -->
      <div style="margin-top: 48px; text-align: center; font-size: 12px; color: #94a3b8;">
        <p>
          <a href="/" style="color: #475569; text-decoration: none; font-weight: 600;">biotama.cv</a>
          <span style="margin: 0 8px;">•</span>
          <a href="/resume" style="color: #475569; text-decoration: none; font-weight: 600;">Master Resume</a>
        </p>
      </div>
    </div>
  </body>
</html>
