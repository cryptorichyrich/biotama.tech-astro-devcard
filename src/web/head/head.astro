---
import Fonts from '@/components/fonts.astro';
import type { MetaConfig } from '@/types/config/meta-config.types';
import type { Sections } from '@/types/data';
import Favicons from './favicons.generated.astro';
import InitialHash from './initial-hash.astro';
import InitialTheme from './initial-theme.astro';
import Meta from './meta.astro';

interface Props {
  meta: MetaConfig;
  sections: Sections;
  ogType?: 'website' | 'article';
  canonicalURL?: string;
  article?: {
    publishedTime?: string;
    author?: string;
    tags?: string[];
    section?: string;
  };
  jsonLd?: object | object[];
}

const { meta, sections, ogType, canonicalURL, article, jsonLd } = Astro.props;
---

<head>
  <Meta meta={meta} ogType={ogType} canonicalURL={canonicalURL} article={article} jsonLd={jsonLd} />
  <Favicons />
  <InitialHash sections={sections} />
  <InitialTheme />
  <Fonts />
</head>
