---
import type { Config, Sections } from '@/types/data';
import Head from '@/web/head/head.astro';
import HeaderMenu from '@/web/components/header.astro';

interface Props extends Config {
  sections: Sections;
  ogType?: 'website' | 'article';
  canonicalURL?: string;
  article?: {
    publishedTime?: string;
    author?: string;
    tags?: string[];
    section?: string;
  };
  jsonLd?: object | object[];
}

const { meta, i18n, sections, ogType, canonicalURL, article, jsonLd } = Astro.props;
---

<!DOCTYPE html>
<html lang={i18n.locale.code} class="scroll-smooth">
  <Head meta={meta} sections={sections} ogType={ogType} canonicalURL={canonicalURL} article={article} jsonLd={jsonLd} />
  <body class="flex justify-center overflow-x-hidden bg-gray-50 dark:bg-[#000] xl:relative xl:left-7">
    <HeaderMenu />
    <slot />
  </body>
</html>
